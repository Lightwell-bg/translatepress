# LingoCanvas Cloud secrets and critical settings. Copy to .env and fill in.
# Non-secret constants live in config.ini.

# PostgreSQL (async driver). Locally: run `python scripts/local_pg.py start` and paste the URL it prints.
DATABASE_URL=

# Provider: deepseek | mock (mock = fake translations, no paid calls)
PROVIDER=mock

# DeepSeek API key (needed only when PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# Secret for hashing site tokens, at least 32 random characters.
# Changing it invalidates every issued token. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_PEPPER=

# Kill switch: stop calling the provider once today's (UTC) cost reaches this many USD
DAILY_SPEND_LIMIT_USD=5

# Password of the PostgreSQL container, used ONLY by docker-compose.yml (future VPS deployment).
# Compose builds DATABASE_URL for the api/migrate services from it, so DATABASE_URL above is ignored there.
# Generate: python -c "import secrets;print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# Stripe billing (leave STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET empty to switch billing off: endpoints answer 503 billing_disabled).
# Secret API key: sk_test_... in test mode. Dashboard -> Developers -> API keys. See docs/STRIPE_SETUP.md
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint: whsec_... (Dashboard -> Developers -> Webhooks, or printed by `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# Price ids (price_...) of the two products: Starter monthly subscription and the 250k pack
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PACK_250K=

# Needed for the customer portal: id (bpc_...) of the Customer Portal configuration made for LingoCanvas only. Empty = the portal answers 503 portal_not_configured (never falls back to the account default).
STRIPE_PORTAL_CONFIGURATION=

# false = only test-mode events are processed, true = only live-mode events. Must match the key above.
STRIPE_LIVEMODE=false
