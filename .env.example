# Скопируйте этот файл в .env и заполните значения.
# .env в .gitignore — реальные ключи в репозиторий не попадают.
#
# На Этапе 1 ни один ключ не используется: перевод вводится вручную
# через админку. Файл заведён заранее под Этап 3 (автоперевод).

# OpenAI API — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Модель для перевода (Этап 3)
OPENAI_MODEL=
