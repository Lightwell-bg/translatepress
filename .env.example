# Этот файл — резервный, необязательный способ настройки OpenAI.
# Основной способ — «Мультиязычность → Языки» в админке: ключ там хранится
# в базе данных, доступ к файлам хостинга для этого не нужен.
#
# Используйте .env вместо админки, только если предпочитаете хранить ключ
# вне базы данных (например, чтобы он не попадал в дампы/бэкапы БД).
# Если поле в админке заполнено, оно в приоритете — значения из .env
# используются, только когда поле в настройках пустое.
#
# Скопируйте этот файл в .env — он уже в .gitignore, в репозиторий не попадёт.
#
# В любом случае перевод запускается только вручную, по нажатию кнопки —
# плагин ничего не переводит сам и не ходит в OpenAI в фоне.

# Ключ OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Идентификатор модели. Сверьте точное написание с личным кабинетом/
# документацией OpenAI, если кнопка «Перевести с ИИ» будет отвечать
# ошибкой про неизвестную модель.
OPENAI_MODEL=gpt-5.6-terra

# Адрес API. Меняйте только если используете свой прокси или совместимый
# шлюз вместо api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1
