# Скопируйте этот файл в .env и заполните значения.
# .env в .gitignore — реальные ключи в репозиторий не попадают.
#
# Без OPENAI_API_KEY кнопка «Перевести с ИИ» в админке просто не появится —
# остальной плагин работает как обычно, перевод строк вручную никуда не денется.
# Перевод запускается только вручную, по нажатию кнопки — плагин ничего
# не переводит сам и не ходит в OpenAI в фоне.

# Ключ OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Идентификатор модели. Значение ниже — то, что указал владелец сайта;
# сверьте точное написание с личным кабинетом/документацией OpenAI, если
# кнопка «Перевести с ИИ» будет отвечать ошибкой про неизвестную модель.
OPENAI_MODEL=gpt-5.6-terra

# Адрес API. Меняйте только если используете свой прокси или совместимый
# шлюз вместо api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1
