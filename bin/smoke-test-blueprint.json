{
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": false,
  "steps": [
    {
      "step": "runPHP",
      "code": "<?php require '/out/smoke-test-wpconfig.php';"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php @mkdir('/wordpress/wp-content/mu-plugins', 0777, true); foreach ( glob('/out/lingocanvas-smoke-*.php') as $f ) { copy($f, '/wordpress/wp-content/mu-plugins/' . basename($f)); }"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "lingocanvas/lingocanvas.php"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $GLOBALS['MLP_SMOKE_PHASE']='setup'; require '/out/smoke-test.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/'; $GLOBALS['MLP_SMOKE_PAGE']='default_front'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/smoke-post/'; $GLOBALS['MLP_SMOKE_PAGE']='default_post'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/en/'; $GLOBALS['MLP_SMOKE_PAGE']='en_front'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/en/smoke-post/'; $GLOBALS['MLP_SMOKE_PAGE']='en_post'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $GLOBALS['MLP_SMOKE_PHASE']='check1'; require '/out/smoke-test.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/en/smoke-post/'; $GLOBALS['MLP_SMOKE_PAGE']='en_post_after'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/en/smoke-post/'; $GLOBALS['MLP_SMOKE_BUFFER_MODE']='trace'; $GLOBALS['MLP_SMOKE_PAGE']='buf_trace'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/en/smoke-post/'; $GLOBALS['MLP_SMOKE_BUFFER_MODE']='core_off'; $GLOBALS['MLP_SMOKE_PAGE']='buf_core_off'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/en/smoke-post/'; $GLOBALS['MLP_SMOKE_BUFFER_MODE']='open_buffer'; $GLOBALS['MLP_SMOKE_PAGE']='buf_open'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/en/smoke-post/'; $GLOBALS['MLP_SMOKE_BUFFER_MODE']='exit'; $GLOBALS['MLP_SMOKE_PAGE']='buf_exit'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/en/smoke-post/'; $GLOBALS['MLP_SMOKE_BUFFER_MODE']='late_template'; $GLOBALS['MLP_SMOKE_PAGE']='buf_late'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/lingocanvas-sitemap.xml'; $GLOBALS['MLP_SMOKE_PAGE']='sitemap'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php $_SERVER['REQUEST_URI']='/smoke-switch/'; $GLOBALS['MLP_SMOKE_PAGE']='switcher'; require '/out/smoke-test-render.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $GLOBALS['MLP_SMOKE_PHASE']='extra'; require '/out/smoke-test.php';"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $GLOBALS['MLP_SMOKE_PHASE']='check2'; require '/out/smoke-test.php';"
    }
  ]
}