{
    "name": "wp-mlp/wp-multilang-press",
    "description": "LingoCanvas: WordPress multilingual plugin with one post, a URL per language and string translations stored in dedicated tables",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "WpMlp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpMlp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
